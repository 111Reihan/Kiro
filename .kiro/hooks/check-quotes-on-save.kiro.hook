{
  "enabled": true,
  "name": "Check quotes on save",
  "description": "When a markdown file is saved, grade every quoted passage against the loaded sources.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["**/*.md", "!**/node_modules/**", "!.kiro/**"] },
  "then": {
    "type": "askAgent",
    "prompt": "The file that was just saved is markdown. Call the revenant MCP tool check_text with its full text. Report only quotations that are not verbatim: the verdict, severity, and the word diff. If every quote is verbatim, say so in one line. Never call an unsupported quote fake: say it was not found in the loaded sources."
  }
}
