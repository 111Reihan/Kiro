{
  "enabled": true,
  "name": "UI guardrails",
  "description": "When UI source changes, check the rules the CSP and the design depend on.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["web/src/**/*.tsx", "web/src/**/*.ts", "web/src/**/*.css"] },
  "then": {
    "type": "askAgent",
    "prompt": "In web/src, check for: innerHTML or dangerouslySetInnerHTML, http(s):// asset URLs, any status shown by colour alone (it needs an icon and a word), animations without a prefers-reduced-motion path. Report violations with file:line. Do not rewrite anything."
  }
}
