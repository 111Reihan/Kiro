{
  "enabled": true,
  "name": "Vet and test after a Go edit",
  "description": "When Go source is saved, vet and test the package.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["cmd/**/*.go", "internal/**/*.go"] },
  "then": {
    "type": "askAgent",
    "prompt": "Run `go vet` and `go test -race` for the package containing the file that changed. Report failures only. If a test has a covers comment, name the requirement it proves."
  }
}
