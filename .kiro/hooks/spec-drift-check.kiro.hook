{
  "enabled": true,
  "name": "Spec drift check",
  "description": "Manual: run specter check and explain every requirement that drifted.",
  "version": "1",
  "when": { "type": "userTriggered" },
  "then": {
    "type": "askAgent",
    "prompt": "Run `go run ./cmd/specter check`. For each requirement it lists, run `go run ./cmd/specter explain <id>` and tell me what changed (the ghost diff), which test is affected, and whether the code or the requirement should change. Do not edit anything; do not seal."
  }
}
